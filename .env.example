# payments-mpp environment configuration.
# Copy this file to .env and fill in every empty value before starting the
# server or the agent. Never commit .env (see .gitignore). Never put a real
# secret in this file.

# ---------------------------------------------------------------------------
# shared — read by both server and agent, same value in both processes
# ---------------------------------------------------------------------------

# Stellar network to operate against: stellar:testnet | stellar:pubnet.
STELLAR_NETWORK=stellar:testnet

# Soroban RPC endpoint used for simulation, submission, and close_start polling.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# SEP-41 USDC Stellar Asset Contract id (56 chars, starts with C).
USDC_SAC_CONTRACT=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA

# Base URL used to build explorer links attached to events and API responses.
EXPLORER_BASE_URL=https://stellar.expert/explorer/testnet

# Price per MiB, in raw units (1e-7 USDC). No default on purpose: an unset
# price must never be silently treated as free or as an invented fallback.
# MUST be identical in server and agent — a mismatch surfaces as
# amount_rejected on the very first request (AC-R3, design 4.4). Defined once
# here, not per-role: with a single shared .env file, defining it twice would
# let dotenv's last-key-wins silently desync the two processes (review
# finding, Lote B — the same bug class as the MPP_SECRET_KEY collision below).
PRICE_PER_MIB_RAW=

# one-way-channel contract id (C..., 56 chars). THIS is the stage-2 switch
# (WU6/WU7): once it is set, the server also requires COMMITMENT_PUBKEY and
# FUNDER_ACCOUNT, and the agent also requires COMMITMENT_SECRET — enforced by
# a single zod check in config/env.ts (CF-R1), not left as a per-field
# comment. Defined once here for the same reason as PRICE_PER_MIB_RAW above —
# both server and agent must read the identical value.
CHANNEL_CONTRACT=

# Directory for the append-only voucher log and the events cursor file.
DATA_DIR=./data

# Minimum log level written to stdout as JSON lines: debug | info | warn | error.
LOG_LEVEL=info

# Optional webhook endpoint. When set, every emitted event is also POSTed here
# fire-and-forget (2s timeout, up to 3 retries, bounded queue). Leave unset to
# rely on stdout only.
# BACKEND_EVENTS_URL=

# ---------------------------------------------------------------------------
# server — recipient / collector process
# ---------------------------------------------------------------------------

# HTTP port the payment server listens on.
PORT=8080

# Recipient Stellar account (G..., 56 chars). Required in stage 1.
STELLAR_RECIPIENT=

# Generic HMAC secret mppx uses to bind challenges to their contents (server
# only — the agent never reads this variable; see the deviation note in
# docs/sdd/payments-mpp.md §6). Confirmed against the installed
# @stellar/mpp/mppx source (Spike S3): this is NOT a Stellar keypair, just a
# non-empty string passed to `Mppx.create({ secretKey })`. Never appears in
# logs, events, or /ready.
MPP_SECRET_KEY=

# Secret key (S..., 56 chars) that pays network fees as the sponsored
# transaction's source and fee payer (`feePayer.envelopeSigner` in
# @stellar/mpp). Never appears in logs, events, or /ready.
FEE_PAYER_SECRET=

# Commitment public key (64 hex chars) used to verify voucher signatures.
# Required in stage 2.
COMMITMENT_PUBKEY=

# Funder Stellar account (G..., 56 chars). Required in stage 2: used for the
# pre-close trustline check (CL-R9) and the post-close refund delta assertion
# (CL-R10).
FUNDER_ACCOUNT=

# Trigger settle() once unsettled debt reaches this fraction of the deposit,
# in basis points (5000 = 50%, CL-R5).
SETTLE_THRESHOLD_BPS=5000

# How often (ms) the server polls Soroban getEvents for a close_start signal.
CHANNEL_POLL_INTERVAL_MS=30000

# On first boot with no persisted cursor, how many ledgers to look back when
# starting the close_start monitor.
CLOSE_MONITOR_LOOKBACK_LEDGERS=120

# How many times to re-read the funder's balance after close() before giving
# up and reporting refund_not_received (CL-R10).
CLOSE_ASSERT_ATTEMPTS=6

# Delay (ms) between post-close balance re-reads.
CLOSE_ASSERT_INTERVAL_MS=2500

# Minimum time (ms) between fail-closed re-initialization attempts (FC-R8).
INIT_RETRY_INTERVAL_MS=10000

# Timeout (ms) for the boot-time Soroban RPC health check (FC-R4).
RPC_HEALTH_TIMEOUT_MS=2000

# ---------------------------------------------------------------------------
# agent — funder / payer process
# ---------------------------------------------------------------------------

# HTTP port the agent listens on for POST /vouchers.
AGENT_PORT=8081

# Shared secret the gateway must send as X-Gateway-Token. Compared in
# constant time; missing or wrong value gets a 401 (VE-R1).
GATEWAY_TOKEN=

# Base URL of the payment server, for the internal agent -> server hop that
# the gateway never sees.
PAYMENT_SERVER_URL=http://127.0.0.1:8080

# Secret key (S..., 56 chars) that signs Soroban authorization entries for the
# stage 1 sponsored charge. The agent never pays network fees with it (S1-R3).
# The agent does NOT read MPP_SECRET_KEY — that variable belongs to the
# server's mppx challenge signing only (see the shared/server sections above
# and the deviation note in docs/sdd/payments-mpp.md §6).
SIGNER_SECRET=

# Stellar secret seed (S..., 56 chars — SAME format as SIGNER_SECRET/
# FEE_PAYER_SECRET, e.g. from `Keypair.random().secret()`) that signs
# commitment maps in stage 2. Required in stage 2. Never appears in logs,
# events, or /ready.
COMMITMENT_SECRET=

# Reject any single request whose delta against the last signed cumulative
# amount exceeds this many raw units — guardrail against a runaway meter
# (AC-R7).
MAX_DELTA_PER_REQUEST_RAW=5000000

# Expected minimum interval (ms) between gateway calls to POST /vouchers.
# Informational only: correctness never depends on the gateway honoring it —
# the per-channel mutex (VE-R12) guarantees the result regardless (VE-R13).
METER_REPORT_INTERVAL_MS=10000

# Timeout (ms) for depositPort.getDepositRaw and signer.sign while POST
# /vouchers holds the per-channel mutex (VE-R12) — neither call may hang the
# lock indefinitely. A timeout maps to upstream_unavailable/signer_unavailable
# (both retryable).
PORT_CALL_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# connectivity — Telnyx Wireless (eSIM provisioning & data limits)
# ---------------------------------------------------------------------------

# Account API key (generated in portal.telnyx.com → API Keys). Auth for every
# call: `Authorization: Bearer <key>`. Mandatory: the provider refuses to boot
# without it (fail-fast in createTelnyxProvider). Never appears in logs.
TELNYX_API_KEY=

# UUID of the SIM Card Group that owns every eSIM the connectivity layer
# purchases (safety data_limit + cost attribution). Reusable: one group for the
# whole deployment is fine. Mandatory, same fail-fast rule.
TELNYX_SIM_GROUP_ID=

# Price per MB of Telnyx data, in raw units (1e-7 USDC), used by the
# PolicyEnforcer to convert gateway-measured bytes into what the channel's
# remaining balance can still pay (setDataLimit) and when to disable. No
# default on purpose; the grid sets it per real carrier pricing.
# Must be the SAME tariff as PRICE_PER_MIB_RAW (per MiB = 1_048_576 bytes):
# PRICE_PER_MIB_RAW = ceil(TELNYX_PRICE_PER_MB_USDC × 1.048576). Otherwise the
# agent and the policy disagree on when the channel runs out; the meter
# service refuses to start with misaligned prices (shared/money.ts
# arePricesAligned). E.g. 1 USDC/MB -> 10000000 here, 10485760 there.
TELNYX_PRICE_PER_MB_USDC=

# ---------------------------------------------------------------------------
# meter — traffic meter / gateway side of POST /vouchers
# ---------------------------------------------------------------------------

# Full URL of the agent's voucher endpoint the meter calls for every reading
# (src/meter/voucher-port.ts). Leave unset to keep `npm run demo:flow` fully
# offline (in-memory voucher double). When set, the demo talks to the real
# agent (`npm run agent:serve`) and also needs, from the sections above, the
# SAME values the agent reads: GATEWAY_TOKEN (sent as X-Gateway-Token),
# CHANNEL_CONTRACT (the agent rejects any other channel), PRICE_PER_MIB_RAW
# (a mismatch is amount_rejected) and STELLAR_NETWORK.
# AGENT_VOUCHERS_URL=http://127.0.0.1:8081/vouchers
